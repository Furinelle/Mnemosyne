{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "mnemosyne hook SessionStart", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "mnemosyne hook UserPromptSubmit", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "mnemosyne hook PreToolUse", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "mnemosyne hook Stop", "timeout": 5 }
        ]
      }
    ]
  }
}
